# MU1 control plane (docs/specs/2026-09-08-multi-user-control-plane-design.md): login, sessions and
# credential issuance for mocactl. packages/control-plane/src/main.ts reads every setting below.
#
# SECRETS ARE NOT HERE. SH_SESSION_TOKEN_PRIVATE_KEY, SH_CREDENTIAL_KEK and SH_EXCHANGE_TOKEN are
# systemd credentials (LoadCredential= in sh-control-plane.service), generated once by setup-vm.sh
# into /etc/serverless-harness/credentials/. Setting one here as well makes the control plane refuse
# to boot.

# 8080 is the supervisor's. The supervisor's SH_CONTROL_PLANE_URL dials this port.
SH_CONTROL_PLANE_PORT=8090
# Loopback: the control plane speaks plain HTTP. Reach it through an SSH tunnel (deploy/vm/README.md,
# "The control plane"). 0.0.0.0 exposes it on every interface -- only behind a firewall allowlist.
SH_CONTROL_PLANE_HOST=127.0.0.1

# The sessions/ownership index: the Redis start_redis publishes on loopback.
REDIS_URL=redis://127.0.0.1:6379

# Credentials as one envelope-encrypted file per subject, in the unit's StateDirectory (0700).
# SH_CREDENTIAL_STORE=vault is the multi-host option (VAULT_ADDR, VAULT_TOKEN_FILE; see
# packages/control-plane/src/vault-store.ts) and is not wired by setup-vm.sh.
SH_CREDENTIAL_STORE=file
SH_CREDENTIAL_DIR=/var/lib/moca-control-plane

# REQUIRED before setup-vm.sh starts the control plane. A GitHub OAuth app's client id, with device
# flow ENABLED (it is off by default in GitHub's settings). The control plane refuses to boot without it.
# No client secret. Setup: deploy/vm/README.md, "The GitHub OAuth app". setup-vm.sh fills this (and
# SH_PUBLIC_HARNESS_URL) from its own environment while it is empty, and never replaces a value here.
SH_GITHUB_CLIENT_ID=
# REQUIRED before setup-vm.sh starts the control plane. The harness (supervisor, port 8080) as CLIENTS
# reach it -- advertised by GET /v1/discovery, so mocactl needs only the control plane's URL. Behind
# an SSH tunnel it is the tunnel's local end, e.g. http://127.0.0.1:8080, and every user must then
# forward that same local port. Not the VM's own view of itself.
SH_PUBLIC_HARNESS_URL=

# Comma-separated subjects (github:<id>) granted the admin role.
#SH_ADMIN_SUBJECTS=
# Gateway origin for a credential that carries no endpoint of its own, and the operator fallback's
# endpoint (spec §6.2). For Anthropic itself, the bare origin https://api.anthropic.com (no /v1).
#SH_DEFAULT_INFERENCE_ENDPOINT=
# Operator-key fallback: exactly `true` lets every user WITHOUT their own inference credential spend
# the operator's key (spec §6.4). Off by default. The key is a secret, never a line here: put it in
# /etc/serverless-harness/credentials/operator-inference-token (0600) and re-run setup-vm.sh, which
# loads it with a drop-in (deploy/vm/README.md, "The operator-key fallback").
#SH_ALLOW_OPERATOR_FALLBACK=false
# The header the operator's key travels in: authorization (Bearer: a gateway token, the default) or
# x-api-key (an Anthropic API key, with SH_DEFAULT_INFERENCE_ENDPOINT=https://api.anthropic.com).
# The control plane refuses to boot on a key, header and endpoint that cannot work together.
#SH_OPERATOR_INFERENCE_HEADER=authorization
# Token lifetimes, in seconds (defaults shown). The API token is short because it is never
# revoked; the refresh token behind it is (mocactl logout).
#SH_API_TOKEN_TTL_SECONDS=900
#SH_SESSION_TOKEN_TTL_SECONDS=300
# A login lasts 30 days from its last use and 90 days at most; a just-replaced refresh token is
# answered again for 30 seconds so a retried request is not mistaken for theft.
#SH_REFRESH_IDLE_TTL_SECONDS=2592000
#SH_REFRESH_MAX_TTL_SECONDS=7776000
# A client whose refresh response is lost (laptop sleeps mid-request) and retries after this grace is
# treated as reuse and must log in again; raise the grace (max 300) if that bites.
#SH_REFRESH_REUSE_GRACE_SECONDS=30

# Sandbox tiers a session may choose at creation (P6.3); must match supervisor.env exactly.
#SH_SANDBOX_TIERS=container,microvm
#SH_SANDBOX_DEFAULT_TIER=container
