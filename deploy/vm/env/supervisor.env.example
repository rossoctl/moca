# Supervisor process management (spec §3.8)
PORT=8080
# Admin listener (/metrics, /healthz, /readyz) bind address. Loopback here, on purpose: it is
# unauthenticated. Only a deployment with its own access control in front (deploy/k8s, NetworkPolicy) widens it.
#SH_ADMIN_HOST=127.0.0.1
# SH_WORKERS defaults to os.availableParallelism() -- the CPU count this deployment may actually use,
# so a cgroup CPU quota (--cpus=N, a Kubernetes CPU limit) caps it rather than the host's core count.
# Set it to pin W across an E8 ladder.
#SH_WORKERS=4
# REQUIRED, no default: S is an OUTPUT of E8, so there is no honest value to ship (§3.8).
SH_TURNS_PER_WORKER=
SH_ROUTING_POLICY=leastInFlight
SH_WORKER_RESTART_BACKOFF_MS=250
# Per-subject admission quota (#360, MI1 §13), read by the WORKERS from this inherited environment:
# how many in-flight turns ONE authenticated subject may hold per worker. Unset, it is half of
# SH_TURNS_PER_WORKER (max(1, S/2)), so a single user can never hold more than half the pool. A
# subject over it gets 429 subject_quota_exceeded with Retry-After -- distinct from the supervisor's
# pool-wide `overloaded`. Unauthenticated turns are not counted: they have no subject.
#SH_TURNS_PER_SUBJECT=

# Sandbox routing: relay presence records are the only inventory (ADR-0041); the flag
# turns reading them on. On a VM there is no cluster and no kubeconfig.
SH_REMOTE_SANDBOX=1
# Sandbox tiers (P6.3, docs/specs/2026-10-04-p6-on-kubernetes-slice3-design.md). Set them ONLY on a
# host that runs both container sandboxes and a P4 microVM worker: deploy/microvm/setup-microvm.sh
# does it for you, through its own drop-in. Unset, nothing is filtered by tier and a session still
# returns to its sandbox. Must match control-plane.env exactly.
#SH_SANDBOX_TIERS=container,microvm
#SH_SANDBOX_DEFAULT_TIER=container
# How long a turn waits (503) for its session's sandbox to come back before moving the session to
# another sandbox of its tier on a fresh workspace, and how long the session remembers its sandbox
# (keep it >= the P4 worker's SH_WORKSPACE_IDLE; the relay's copy in relay.env must match).
#SH_SANDBOX_AFFINITY_GRACE_SECONDS=60
#SH_SANDBOX_AFFINITY_TTL_SECONDS=86400
# Dials the relay's EXEC listener (MOCA_RELAY_EXEC_ADDR in relay.env.example), not SH_RELAY_PORT --
# the two ports must agree.
SH_RELAY_ADDR=127.0.0.1:9444

# Detachable turns (turn-reattach spec §5.6). 1: a turn mocactl starts outlives its connection and
# can be re-attached. Unwatched turns end after SH_TURN_DETACHED_MAX_S (default 1800); a finished
# turn stays replayable for SH_TURN_LOG_TTL_S (default 86400).
SH_TURN_DETACH=1
SH_TURN_DETACHED_MAX_S=
SH_TURN_LOG_TTL_S=

# Async turns (#389, docs/specs/2026-11-05-p6-async-fan-out-design.md). 1: every worker in this pool
# also drains the leaf queue, running turns submitted through the control plane's
# POST /v1/sessions/{id}/turns instead of over a held connection. Off by default; a deployment that
# never submits async turns pays nothing.
#
# It needs nothing else set. The claim hop reuses SH_CONTROL_PLANE_URL and the SH_EXCHANGE_TOKEN
# credential this unit already loads, and REDIS_URL for the queue. Set with any of those missing, or
# with MOCA_TENANCY=multi (the control plane answers 501 until M2), the worker logs the reason and
# does not drain -- it keeps serving sync /turn normally.
#
# The drain shares SH_TURNS_PER_WORKER with sync /turn: one cap, no reserved headroom. A full queue
# can therefore occupy every slot. Watch `async_claim_denied_full` on the admin /metrics for the two
# competing. SH_ASYNC_DRAIN is quoted in that same body, so all-zero async counts are readable.
#
# Three timings are fixed in code, not knobs, and an operator needs them to tell "stuck" from
# "working as designed": a turn whose worker died is reclaimed by another after 90 s idle (a healthy
# long turn is kept alive by a 30 s heartbeat, so it is never reclaimed while it runs), and the 4th
# delivery dead-letters it -- the turn record goes to `lost` with a failed result. Worst case from
# crash to dead letter is therefore about 4.5 minutes.
#SH_ASYNC_DRAIN=1

# The leaf result's retention, and what the turn record's own TTL is derived from (+1 h margin), so
# the record always outlives the result it explains. Set it on BOTH processes or neither: raising it
# only on the control plane leaves the worker's own async leaf results (#389) expiring on the old
# default while the turn record that explains them lives on the new one.
#LEAF_RESULT_TTL_SECONDS=86400

# Inherited unchanged from the Knative deployment.
REDIS_URL=redis://127.0.0.1:6379
KAGENTI_SANDBOX_POOL_SELECTOR=app=sandbox
KAGENTI_SANDBOX_CAP=4

# The WORKERS' credential for the relay's SandboxExec (MI1 §5 R5), distinct from SH_RELAY_TOKEN,
# which sandboxes hold. The relay refuses to boot without it and the supervisor's workers send it on
# every exec, so the two files must carry the SAME value. setup-vm.sh generates it into both when
# absent; never give it to a sandbox container.
#MOCA_RELAY_EXEC_TOKEN=

# MU1 caller authentication (docs/specs/2026-09-08-multi-user-control-plane-design.md): the workers
# verify session tokens from the control plane setup-vm.sh installs beside this unit
# (sh-control-plane.service) and exchange them for the caller's credential.
#
# SH_SESSION_TOKEN_PUBLIC_KEYS is that control plane's public keyset (`<kid>:<base64 SPKI>`). It is
# public, so it is an env line; setup-vm.sh writes it on the run that generates the keypair, and never
# again. The exchange token is a SECRET and is not here: it is a systemd credential
# (LoadCredential=SH_EXCHANGE_TOKEN in sh-supervisor.service), the very file the control plane loads.
# Setting SH_EXCHANGE_TOKEN here as well makes the workers refuse to boot.
#SH_SESSION_TOKEN_PUBLIC_KEYS=
# The control plane as the SUPERVISOR reaches it: loopback, SH_CONTROL_PLANE_PORT in control-plane.env.
SH_CONTROL_PLANE_URL=http://127.0.0.1:8090
# Exactly `true` makes every turn need a session token; anything else leaves unauthenticated /turn open.
# True because this VM always runs a control plane.
SH_REQUIRE_AUTH=true
