[Unit]
Description=MOCA supervisor (P6 VM process manager)
# Redis is a bare podman container started by start_redis() in setup-vm.sh, not a systemd
# unit -- there is nothing here for Requires= to name. The client retries on connect, so
# ordering against Redis is not load-bearing.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=harness
Group=harness
# Run from the supervisor's own package dir: `node --import
# tsx` resolves the tsx loader relative to the CWD, and tsx (a devDep) is linked only into
# each package's own node_modules, never root-hoisted -- a CWD of the repo root crashes with
# ERR_MODULE_NOT_FOUND 'tsx'. Do not "simplify" this back to the repo root.
WorkingDirectory=/opt/serverless-harness/packages/supervisor
EnvironmentFile=/etc/serverless-harness/supervisor.env
# MU1: the exchange token the workers present to the control plane, as a systemd credential (MI1
# §6.7) -- the same file sh-control-plane.service loads. setup-vm.sh creates it before installing
# this unit; a unit whose credential file is missing does not start.
LoadCredential=SH_EXCHANGE_TOKEN:/etc/serverless-harness/credentials/exchange-token
# This unit sets HOME explicitly with a writable path behind it (the relay's unit does not,
# consistent with this being a harness-side need rather than the relay's). This unit runs as User=harness -- which the README has the operator
# create with --no-create-home -- under ProtectHome=true and ProtectSystem=strict, so $HOME is a
# nonexistent or masked path and the only writable locations are PrivateTmp's /tmp and
# StateDirectory. Without this, any turn that writes agent or session state under $HOME fails at
# runtime, after a completely green bring-up. PrivateTmp=true below is what makes /tmp writable
# and per-unit, so this is the same pairing the manifests use, not a bare env var.
Environment=HOME=/tmp
ExecStart=/usr/bin/node --import tsx src/main.ts
Restart=always
RestartSec=2
# SIGTERM to the MAIN PROCESS ONLY, then SIGKILL to whatever is left in the cgroup at
# TimeoutStopSec. That is what the supervisor's own shutdown assumes: main.ts::close() runs an
# ordered drainAll() -> stop accepting -> awaitIdle(SHUTDOWN_GRACE_MS), and workers exit on their
# own via the 'disconnect' handler once it finishes. Under the previous KillMode=control-group,
# systemd's stop job delivered SIGTERM to EVERY process in the cgroup, so on `systemctl
# stop`/`restart` all W workers died immediately on Node's default disposition (worker.ts installs
# no SIGTERM handler) and close() then drained a pool that was already gone -- §3.9's "in-flight
# turns run to completion" never happened on the real deployment. `mixed` still accounts for the
# whole tree at the deadline, which is what control-group was here for.
KillMode=mixed
# §3.7: SIGTERM starts the drain. The deadline must exceed the longest turn E6 measured.
TimeoutStopSec=120

# §4.3 — the VM analogue of the pod securityContext. PRESENT, not equivalent: this narrows
# the filesystem and syscall surface, and it is deliberately NOT claimed as parity in the
# round-one report. What round one genuinely loses versus Kubernetes is NetworkPolicy egress
# control (Z2/Z5 work), which has no systemd analogue at all.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# systemd creates and owns /var/lib/serverless-harness for us; do not re-add a
# ReadWritePaths= beside it -- that would name a path nothing creates.
StateDirectory=serverless-harness
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
