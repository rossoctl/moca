# deploy/sbx/egress-allow.env -- the default guest-egress allowlist for the SBX0 service.
#
# systemd EnvironmentFile format (the same file install-host.sh seeds as
# /etc/sbx/moca-egress.env): one MOCA_EGRESS_ALLOW line, a comma-separated list of
# hosts. Entries are hostnames, IP literals, or *.suffix wildcards (strict subdomains
# only); an optional :port narrows an entry to that port (remote-worker/internal/egress).
#
# To use it:
#   - Fresh host:     nothing to do -- install-host.sh seeds /etc/sbx/moca-egress.env from
#                    this file beside it (and never overwrites one that is already there).
#   - Existing host:  sudo install -m 0644 deploy/sbx/egress-allow.env /etc/sbx/moca-egress.env
#                    sudo systemctl restart moca-egress
#   - One install with a different list: export MOCA_EGRESS_ALLOW=<hosts> before
#                    install-host.sh; it overrides this file for that run's seed only.
# Editing this file does not reach hosts that are already seeded (the seed is written only
# when absent); copy it to each host as above.
#
# Entries are grouped: distro and mirror hosts, language-tool downloads, package
# registries, container registries, GitHub. The github.com, api.github.com and
# raw.githubusercontent.com entries are also where the github-personal-access-token
# credential preset is spent; the rest were granted as preset: trusted.
# api.githubcopilot.com is NOT here: add it per host for the github-mcp preset
# (see RUNBOOK.md, "Guest egress").
# export.arxiv.org, tmaproduction.blob.core.windows.net, unpkg.com and cdn.jsdelivr.net
# look task-specific but are kept deliberately (review of #719): all were in live use on
# the host this list was extracted from.
#
# Extracted 2026-11-11 from the live SBX0 allow rules (45 hosts).

MOCA_EGRESS_ALLOW=dl.fedoraproject.org,export.arxiv.org,tmaproduction.blob.core.windows.net,archive.apache.org,dl.google.com,tuf-repo-cdn.sigstore.dev,mirror.openshift.com,istio-release.storage.googleapis.com,dl.k8s.io,get.helm.sh,download.java.net,mise-java.jdx.dev,mise-versions.jdx.dev,cdn.mise.run,mise.jdx.dev,unpkg.com,cdn.jsdelivr.net,sh.rustup.rs,static.crates.io,crates.io,go.dev,sum.golang.org,proxy.golang.org,registry.access.redhat.com,*.pkg.dev,registry.k8s.io,gcr.io,pkg-containers.githubusercontent.com,ghcr.io,production.cloudflare.docker.com,production.cloudfront.docker.com,auth.docker.io,registry-1.docker.io,index.docker.io,quay.io,release-assets.githubusercontent.com,raw.githubusercontent.com,objects.githubusercontent.com,codeload.github.com,api.github.com,github.com,files.pythonhosted.org,pypi.org,registry.yarnpkg.com,registry.npmjs.org
