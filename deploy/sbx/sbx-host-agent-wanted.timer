# deploy/sbx/sbx-host-agent-wanted.timer -- apply the wanted state every 15 seconds.
# Oneshot runs do not overlap; a run takes about a second, plus a worker start when one is wanted.
[Unit]
Description=Apply the SBX0 wanted state every 15 seconds

[Timer]
OnBootSec=30s
OnUnitInactiveSec=15s
AccuracySec=1s

[Install]
WantedBy=timers.target
