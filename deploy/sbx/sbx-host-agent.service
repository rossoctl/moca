# deploy/sbx/sbx-host-agent.service -- one poll of the template host agent (deploy/sbx/host-agent.sh,
# template lifecycle spec §6.1), started by sbx-host-agent.timer. host-agent.env holds SBX_API_URL,
# SBX_HOST_ID, SBX_KERNEL and, optionally, SBX_API_CA_FILE, SBX_REGISTRY and the limits; the token is
# only in host-agent.token, which the script reads itself. Installed by hand, with the timer and
# host-agent.sh (the RUNBOOK's host agent section). After its builds, a poll also applies the wanted
# state; sbx-host-agent-wanted.service does that alone, every 15 s.
[Unit]
Description=SBX0 template host agent: build queued templates, report them, apply the wanted state
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/sbx/host-agent.env
Environment=SBX_ENV_DIR=/etc/sbx
Environment=SBX_SRV=/srv/sbx
Environment=SBX_HOST_TOKEN_FILE=/etc/sbx/host-agent.token
# Installed outside the source tree (/usr/local/libexec), the agent cannot find template-build.sh
# from its own path: point it at the checkout. Overridable in host-agent.env.
Environment=SBX_TEMPLATE_BUILD=/srv/sbx/src/deploy/sbx/template-onboarding/template-build.sh
# The removal of retired builds (§6.1 step 7) runs install-host.sh --uninstall; installed outside the
# tree, the agent cannot find it from /usr/local/libexec, as with template-build.sh.
Environment=SBX_INSTALL_HOST=/srv/sbx/src/deploy/sbx/install-host.sh
# ProtectHome hides root's home, where a podman login may land; use root podman's /run auth file
# (log in with `podman login --authfile /run/containers/0/auth.json <host>`).
Environment=REGISTRY_AUTH_FILE=/run/containers/0/auth.json
# The unit has no HOME and hides root's (ProtectHome), and build-snapshot.sh compiles the guest
# agent with `go build`: give Go a module cache and build cache of its own (otherwise "go:
# module cache not found"). install -d -m 0700 /srv/sbx/go /srv/sbx/home before the first poll.
Environment=HOME=/srv/sbx/home
Environment=GOPATH=/srv/sbx/go
Environment=GOMODCACHE=/srv/sbx/go/pkg/mod
Environment=GOCACHE=/srv/sbx/go/cache
# template-build.sh runs as root (rootfs export, the VMM); it pulls, builds and probes one template.
ExecStart=/usr/local/libexec/sbx-host-agent.sh --once
# A SWE-bench build with its probe takes minutes; one poll must not outlive a few of them.
TimeoutStartSec=2h
Nice=5
NoNewPrivileges=no
PrivateTmp=yes
ProtectHome=yes
