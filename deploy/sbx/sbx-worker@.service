# deploy/sbx/sbx-worker@.service -- one SBX0 template worker (microvm-worker) per instance; %i is
# its worker id. Installed by deploy/sbx/install-host.sh, which writes /etc/sbx/workers/%i.env from
# the bundle deploy/sbx/setup.sh wrote (and rewrites /usr/local/libexec when SBX_LIBEXEC_DIR
# differs). Mirrors deploy/microvm/microvm-worker.service (read it for why each limit and path is
# set) with four differences: its own slice, its own paths, no AssertMemory (the budget is per
# worker, set in the env file), and an ExecStopPost= that ends the VMs left in its slice.
[Unit]
Description=SBX0 sandbox worker %i (microvm-worker)
# No dependency on moca-egress.service here: a worker installed with egress gets one from its own
# drop-in (sbx-worker@<id>.service.d/egress.conf, install-host.sh), and a --no-egress worker gets
# none. In this shared unit it made every worker, --no-egress ones too, start whatever
# moca-egress.service the host had, another install's included.
After=network-online.target
Wants=network-online.target
# As deploy/microvm/microvm-worker.service: fail loudly without KVM, and stop restarting a broken worker after 5 tries in 5 minutes.
AssertPathExists=/dev/kvm
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Slice=sbx-%i.slice
# install-host.sh rewrites this path to SBX_WORKER_BIN (SBX0's own build).
ExecStart=/usr/local/bin/microvm-worker
EnvironmentFile=/etc/sbx/workers/%i.env
KillMode=control-group
# The worker's VMs are not in this unit's cgroup: jailer puts each in a pool-N cgroup beside it in
# sbx-%i.slice, so control-group does not reach them. After every exit (clean stop, crash, timeout)
# this kills the pool-N cgroups of this worker's own slice and waits for them to empty (#795); it
# never fails the stop. deploy/sbx/reap-vms.sh, installed by install-host.sh.
ExecStopPost=-/usr/local/libexec/sbx-reap-vms.sh %i
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s
LimitMEMLOCK=infinity
LimitNOFILE=1048576
Environment=SH_JAILER_BIN=/usr/local/bin/jailer
Environment=SH_FIRECRACKER_BIN=/usr/local/bin/firecracker
Environment=SH_VMM=firecracker
Environment=SH_STANDBY_DEPTH=2
# install-host.sh writes the snapshot's guest RAM into the env file, which overrides this.
Environment=SH_GUEST_RAM_MB=256
Environment=SH_MAX_RUNS=64
Environment=SH_MEMORY_RESERVE_MB=1024

[Install]
WantedBy=multi-user.target
