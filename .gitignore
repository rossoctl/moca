node_modules/
dist/
*.log
.pi/

# Secrets and credentials
.env
.env.*
.env.local
*.key
*.pem
*.p12
credentials.*
# the source module that shares the name; the ignore stays for credential files
!packages/mocactl/src/sbx/credentials.ts
# core.ignorecase (default on macOS/APFS) makes the pattern above match this legitimate
# component source file too, since it has no secret material — the credential model is
# write-only end to end. See src/views/overlays/Sessions.tsx, NewSession.tsx, Login.tsx for
# the sibling naming convention this file follows.
!packages/mocactl/src/views/overlays/Credentials.tsx
secrets.*
*kubeconfig*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Implementation plans are local-only, ephemeral work artifacts (see docs/plans/README.md).
# They go stale the moment code merges; the durable "why" lives in docs/specs/ + docs/adrs/.
docs/plans/*
!docs/plans/README.md

# Workspace-only checksums. Redundant with each module go.sum, and the checksum
# database still verifies downloads without it -- one less sum file to keep in sync.
go.work.sum

# Python bytecode cache -- regenerated on every run wherever a .py file lives.
__pycache__/

# deploy/k8s/setup.sh's per-run overlay and (OCP) self-signed CA
deploy/k8s/.generated/
deploy/sbx/.generated/
deploy/sbx/.generated-*/

# Generated Python stubs for the sandbox/v1 examples (docs/api/sandbox-v1-direct-client.md)
docs/api/examples/sandbox/

# Per-developer agent wiring written by `mocactl sbx up`: it points at one developer's
# sandbox, is re-merged by the next `up`, and differs per working tree (each gets its own
# sandbox). This repo ignores them for every clone; `up` itself only excludes .sbx/, and
# only via .git/info/exclude (see docs/sbx/user-guide.md). .claude/settings.json and
# CLAUDE.md are tracked and stay so -- `up` merges into them inside a marked block.
#
# Anchored to the root, which is the only place `up` writes them: unanchored, these would
# also ignore a future packages/<pkg>/AGENTS.md or a fixture under any subdirectory, and
# `git add` would need -f with no visible reason.
/.bob/
/.mcp.json
/opencode.json
/opencode.jsonc
/AGENTS.md
/.sbx/
