node_modules/
dist/
*.log
.pi/

# Secrets and credentials
.env
.env.*
.env.local
*.key
*.pem
*.p12
credentials.*
# core.ignorecase (default on macOS/APFS) makes the pattern above match this legitimate
# component source file too, since it has no secret material — the credential model is
# write-only end to end. See src/views/overlays/Sessions.tsx, NewSession.tsx, Login.tsx for
# the sibling naming convention this file follows.
!packages/mocactl/src/views/overlays/Credentials.tsx
secrets.*
*kubeconfig*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Implementation plans are local-only, ephemeral work artifacts (see docs/plans/README.md).
# They go stale the moment code merges; the durable "why" lives in docs/specs/ + docs/adrs/.
docs/plans/*
!docs/plans/README.md

# Workspace-only checksums. Redundant with each module go.sum, and the checksum
# database still verifies downloads without it -- one less sum file to keep in sync.
go.work.sum

# Python bytecode cache -- regenerated on every run wherever a .py file lives.
__pycache__/

# deploy/k8s/setup.sh's per-run overlay and (OCP) self-signed CA
deploy/k8s/.generated/
